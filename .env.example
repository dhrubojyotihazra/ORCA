# ORCA Multi-Agent Backend Environment Variables
# SIH Problem Statement 26176

# Groq API Keys (multi-key rotation with failover)
GROQ_API_KEY=gsk_your_primary_groq_api_key
GROQ_API_KEY_VOICE=gsk_your_voice_whisper_api_key
GROQ_API_KEY_REASONING=gsk_your_reasoning_api_key
GROQ_API_KEY_BACKUP=gsk_your_backup_api_key

# Host & Port (Render sets PORT automatically)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated list or '*' for open access)
ALLOWED_ORIGINS=*

# Bhasini ULCA ASR (MeitY Government of India)
BHASINI_UDYAT_KEY=your_bhasini_udyat_key_here
BHASINI_INFERENCE_KEY=your_bhasini_inference_key_here

# Supabase Database & Auth Configuration (SIH26176)
SUPABASE_URL=https://tpsbavjmnqevlvrermnf.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PROJECT_REF=tpsbavjmnqevlvrermnf
