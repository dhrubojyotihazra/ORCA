# ORCA Landing & Frontend Environment Variables
# Deploying to Vercel: Set these in Project Settings -> Environment Variables

# URL of deployed Render backend (e.g. https://orca-backend.onrender.com)
BACKEND_URL=https://orca-backend.onrender.com

# Optional direct FastAPI invocation URL (defaults to /api/agents/invoke)
FASTAPI_AGENT_URL=https://orca-backend.onrender.com/api/agents/invoke

# Groq API Keys for client-side / Edge Route fallback synthesis
GROQ_API_KEY=gsk_your_primary_groq_api_key
GROQ_API_KEY_VOICE=gsk_your_voice_api_key
GROQ_API_KEY_REASONING=gsk_your_reasoning_api_key
GROQ_API_KEY_BACKUP=gsk_your_backup_api_key

# Bhasini ULCA ASR (MeitY Government of India)
BHASINI_UDYAT_KEY=your_bhasini_udyat_key_here
BHASINI_INFERENCE_KEY=your_bhasini_inference_key_here
